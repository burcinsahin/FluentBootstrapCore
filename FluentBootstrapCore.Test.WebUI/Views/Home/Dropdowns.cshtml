@using (Html.Bootstrap().Container().Begin())
{
    var states = new[] { ButtonState.Primary, ButtonState.Secondary, ButtonState.Success, ButtonState.Info, ButtonState.Warning, ButtonState.Danger };

    @Html.Bootstrap().Heading2("Examples")
    @Html.Bootstrap().Heading3("Single button")
    using (Html.Bootstrap().Div().Begin())
    {
        @using (var dropdown = Html.Bootstrap().Dropdown().Begin())
        {
            @dropdown.Button("Dropdown button").State(ButtonState.Secondary).DropdownToggle()
            @using (var dropdownMenu = dropdown.DropdownMenu().Begin())
            {
                @dropdownMenu.DropdownItem("Action", "#")
                @dropdownMenu.DropdownItem("Another action", "#")
                @dropdownMenu.DropdownItem("Something else here", "#")
            }
        }
        <br />
        @using (var dropdown = Html.Bootstrap().Dropdown().Begin())
        {
            @dropdown.LinkButton("Dropdown link").State(ButtonState.Secondary).DropdownToggle()
            @using (var dropdownMenu = dropdown.DropdownMenu().Begin())
            {
                @dropdownMenu.DropdownItem("Action", "#")
                @dropdownMenu.DropdownItem("Another action", "#")
                @dropdownMenu.DropdownItem("Something else here", "#")
            }
        }
        <br />
        foreach (var state in states)
        {
            @using (var buttonGroup = Html.Bootstrap().ButtonGroup().Begin())
            {
                @buttonGroup.DropdownToggle(state.ToString()).State(state)
                @using (var dropdownMenu = buttonGroup.DropdownMenu().Begin())
                {
                    @dropdownMenu.DropdownItem("Action", "#")
                    @dropdownMenu.DropdownItem("Another action", "#")
                    @dropdownMenu.DropdownItem("Something else here", "#")
                    @dropdownMenu.Divider()
                    @dropdownMenu.DropdownItem("Separated link", "#")
                }
            }
        }
    }

    @Html.Bootstrap().Heading3("Split button")
    using (Html.Bootstrap().Div().Begin())
    {
        foreach (var state in states)
        {
            @using (var buttonGroup = Html.Bootstrap().ButtonGroup().Begin())
            {
                @buttonGroup.Button(state.ToString()).State(state)
                @buttonGroup.DropdownToggleSplit().State(state)
                @using (var dropdownMenu = buttonGroup.DropdownMenu().Begin())
                {
                    @dropdownMenu.DropdownItem("Action", "#")
                    @dropdownMenu.DropdownItem("Another action", "#")
                    @dropdownMenu.DropdownItem("Something else here", "#")
                    @dropdownMenu.Divider()
                    @dropdownMenu.DropdownItem("Separated link", "#")
                }
            }
        }
    }
