            {
                @Html.Bootstrap().FormInput("Email address").Type(FormInputType.Email).Placeholder("email@example.com").Margin(Margin.Bottom, 3)
                @Html.Bootstrap().FormInput("Password").Type(FormInputType.Password).Placeholder("Password").Margin(Margin.Bottom, 3)
                @Html.Bootstrap().FormCheck("Remember me").Margin(Margin.Bottom, 3)
                @Html.Bootstrap().Button("Sign in").Type(ButtonType.Submit)
            }
            @Html.Bootstrap().Div().AsDropdownDivider()
            @Html.Bootstrap().Link("New around here? Sign up").AsDropdownItem()
            @Html.Bootstrap().Link("Forgot password?").AsDropdownItem()
