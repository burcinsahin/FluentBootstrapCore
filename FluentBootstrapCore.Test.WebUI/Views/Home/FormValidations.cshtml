@{
    var states = new List<SelectListItem>
    {
        new("Choose...", "", true, true),
        new("...", "1")
    };
}
@Html.Bootstrap().Heading1("Validation")
@Html.Bootstrap().Heading2("Custom styles").Margin(Margin.Top, 5)
@using (Html.Bootstrap().Form().Row().NeedsValidation().Gutter(Gutter.All, 3).Begin())
{
    @using (Html.Bootstrap().Column().Columnize(4, Breakpoint.Medium).Begin())
    {
        @Html.Bootstrap().FormInput("First name").Id("validationCustom01").Value("Mark").Required().ValidFeedback("Looks good!")
    }
    @using (Html.Bootstrap().Column().Columnize(4, Breakpoint.Medium).Begin())
    {
        @Html.Bootstrap().FormInput("Last name").Id("validationCustom02").Value("Otto").Required().ValidFeedback("Looks good!")
    }
    @using (Html.Bootstrap().Column().Columnize(4, Breakpoint.Medium).Begin())
    {
        @Html.Bootstrap().Label("Username", "validationCustomUsername")
        @using (var group = Html.Bootstrap().InputGroup().HasValidation().Begin())
        {
            @group.InputGroupText("@").Id("inputGroupPrepend")
            @group.Input().Id("validationCustomUsername").Attribute("aria-describedby", "inputGroupPrepend").Required()
            @Html.Bootstrap().InvalidFeedback("Please choose a username.")
        }
    }
    @using (Html.Bootstrap().Column().Columnize(6, Breakpoint.Medium).Begin())
    {
        @Html.Bootstrap().FormInput("City").Id("validationCustom03").Required().InvalidFeedback("Please provide a valid city.")
    }
    @using (Html.Bootstrap().Column().Columnize(3, Breakpoint.Medium).Begin())
    {
        @Html.Bootstrap().FormSelect("State").Id("validationCustom04").Options(states).Required().InvalidFeedback("Please select a valid state.")
    }
    @using (Html.Bootstrap().Column().Columnize(3, Breakpoint.Medium).Begin())
    {
        @Html.Bootstrap().FormInput("Zip").Id("validationCustom05").Required().InvalidFeedback("Please provide a valid zip.")
    }
    @using (Html.Bootstrap().Column().Columnize(12).Begin())
    {
        @Html.Bootstrap().FormCheck("Agree to terms and conditions").Id("invalidCheck").Required().InvalidFeedback("You must agree before submitting.")
    }
    @using (Html.Bootstrap().Column().Columnize(12).Begin())
    {
        @Html.Bootstrap().Button("Submit form").Type(ButtonType.Submit)
    }
}

