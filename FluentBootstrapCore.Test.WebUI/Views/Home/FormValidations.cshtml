@Html.Bootstrap().Heading2("Checkboxes and radios").Margin(Margin.Top, 5)
@using (Html.Bootstrap().Form().WasValidated().Begin())
{
    @Html.Bootstrap().FormCheck("Check this checkbox").Id("validationFormCheck1").Required().InvalidFeedback("Example invalid feedback text").Margin(Margin.Bottom, 3)
    @Html.Bootstrap().FormRadio("Toggle this radio").Id("validationFormCheck2").Name("radio-stacked").Required().Margin(Margin.Bottom, 3)
    @Html.Bootstrap().FormRadio("Or toggle this other radio").Id("validationFormCheck3").Name("radio-stacked").Required().InvalidFeedback("More example invalid feedback text").Margin(Margin.Bottom, 3)
    @using (Html.Bootstrap().Div().Margin(Margin.Bottom, 3).Begin())
    {
        @Html.Bootstrap().Label("File example", "validationFile").VisuallyHidden()
        @Html.Bootstrap().FormInput().Id("validationFile").Type(FormInputType.File).Required().InvalidFeedback("Example invalid form file feedback")
    }
    @using (Html.Bootstrap().Div().Margin(Margin.Bottom, 3).Begin())
    {
        @Html.Bootstrap().Button("Submit form").Type(ButtonType.Submit).Disabled()
    }
}

